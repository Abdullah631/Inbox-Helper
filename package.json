{
  "name": "inbox-helper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx scripts/run-eval.ts",
    "typecheck": "tsc --noEmit",
    "eval:drafts": "tsx scripts/run-draft-eval.ts",
    "redteam": "tsx scripts/run-redteam.ts",
    "eval:critic": "tsx scripts/run-critic-eval.ts",
    "label": "tsx scripts/label.ts",
    "check:provider": "tsx scripts/check-provider.ts"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "8.5.30"
  },
  "engines": {
    "node": ">=22.12 <25"
  }
