# Copy to .env.local for local development. Every setting is optional: with no keys
# the app runs in keyword mode. All values are validated at startup (lib/server-config.ts),
# so a typo fails loudly instead of being ignored.

# --- AI providers. Groq is used first; Gemini takes over if Groq fails. ---
# Free keys: https://console.groq.com and https://aistudio.google.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Only change these to point at a proxy or a test server.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Model calls ---
# LLM_TIMEOUT_MS=25000         # one HTTP call
# LLM_MAX_RETRIES=2            # retries on 429/503, last provider only
# LLM_MAX_WAIT_MS=10000        # longest retry wait; longer hints fail fast
# LLM_MAX_OUTPUT_TOKENS=4096   # cap per call (gpt-oss counts its reasoning here)
# REQUEST_BUDGET_MS=50000      # total per API request, kept under Vercel's 60s

# --- Abuse limits, per client address per minute, counted in messages ---
# AI_RATE_LIMIT_PER_MIN=150
# KEYWORD_RATE_LIMIT_PER_MIN=1000
# Extra origins allowed to call the API, comma separated. Leave empty in production.
# ALLOWED_ORIGINS=

# --- Prompt versions (defaults are pinned in lib/prompts.ts, backed by evals) ---
# CLASSIFY_PROMPT_VERSION=v1
# DRAFT_PROMPT_VERSION=v2
# CRITIC_PROMPT_VERSION=v2

# --- Browser-visible (NEXT_PUBLIC_ values are sent to every visitor; never put secrets here) ---
# NEXT_PUBLIC_REPO_URL=https://github.com/Abdullah631/Inbox-Helper
