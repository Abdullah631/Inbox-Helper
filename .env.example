# Optional. Without a key the app uses the keyword classifier.
# Groq is used first if both are set. Free keys: console.groq.com, aistudio.google.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Override the prompt version the app uses (default is set in lib/prompts.ts).
CLASSIFY_PROMPT_VERSION=
